# ==============================================================
#  La Perle Bleue — variables d'environnement
#  Production / Preview : à saisir dans Vercel > Settings > Environment Variables.
#  Local : copier ce fichier en .env.local (jamais commité).
#  Voir README-PRODUCTION.md.
# ==============================================================

# Domaine final, sans slash (e-mails, retour de paiement, webhook). Obligatoire en production.
NEXT_PUBLIC_SITE_URL=https://laperlebleue.fr

# Base Neon (chaîne « pooled » de la branche correspondante : production, preview…).
# Local sans Neon : DATABASE_URL=pglite:./.data/pglite (Postgres embarqué, tests uniquement).
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Mollie (compte du restaurant). test_… en local / preview, live_… en production uniquement.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Méthodes compatibles avec la capture manuelle (défaut : creditcard).
# MOLLIE_METHODS=creditcard
# Répétition générale en production avec une clé test_ (à retirer avant l'ouverture).
# ALLOW_TEST_PAYMENTS_IN_PRODUCTION=true

# Resend (e-mails clients). L'adresse d'expédition doit appartenir à un domaine vérifié dans Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=La Perle Bleue <commandes@laperlebleue.fr>
# RESEND_REPLY_TO=contact@laperlebleue.fr

# Espace cuisine : mot de passe du restaurant (12 caractères minimum conseillés)
# et secret de session (chaîne aléatoire de 32 caractères ou plus : `openssl rand -base64 48`).
ADMIN_PASSWORD=change-moi-maintenant
ADMIN_SESSION_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum

# Tests locaux sans Mollie : faux paiement (ignoré en production).
# PAYMENT_PROVIDER=mock
