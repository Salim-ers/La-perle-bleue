# URL publique du site (sans slash final). Sur Vercel, l'URL de production est détectée automatiquement.
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# ——— Phase 2 : paiement et commandes (ne pas renseigner tant que ce n'est pas branché) ———
# Clés serveur uniquement : ne JAMAIS les préfixer par NEXT_PUBLIC_.
